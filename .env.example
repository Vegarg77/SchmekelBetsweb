# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=production
BASE_URL=http://localhost:3001

# Steam API
# Get your key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Session secret - use a long random string
SESSION_SECRET=change_me_to_something_very_random_and_long_please

# PostgreSQL connection
DATABASE_URL=postgresql://schmekelbets:yourpassword@localhost:5432/schmekelbets
# Or individual parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schmekelbets
DB_USER=schmekelbets
DB_PASSWORD=yourpassword
